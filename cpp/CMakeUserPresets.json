{
  "version": 6,
  "configurePresets": [
    {
      "name": "dev-debug",
      "displayName": "Dev Debug (elegence-vcpkg)",
      "inherits": "windows-debug",
      "environment": { "VCPKG_ROOT": "G:/elegence-vcpkg" }
    },
    {
      "name": "dev-release",
      "displayName": "Dev Release (elegence-vcpkg)",
      "inherits": "windows-release",
      "environment": { "VCPKG_ROOT": "G:/elegence-vcpkg" }
    }
  ],
  "buildPresets": [
    { "name": "dev-debug", "configurePreset": "dev-debug" },
    { "name": "dev-release", "configurePreset": "dev-release" }
  ]
}
